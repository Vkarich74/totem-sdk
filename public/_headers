# TOTEM cache contract for coordinated Backend + SDK payment releases.
# HTML is revalidated; hashed assets may be immutable; PWA worker must update promptly.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/m/*
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
